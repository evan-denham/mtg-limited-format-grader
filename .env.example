# Copy to .env.local and fill in. .env.local is gitignored.
#
# Supabase Dashboard -> Project Settings -> API
#
# VITE_SUPABASE_ANON_KEY must be the "anon" / "public" key. It is designed to
# be shipped in a browser bundle, so it is safe here.
#
# Never put the "service_role" key in this file or anywhere in this project.
# It bypasses row level security entirely and this app is a static site, so
# anything placed here is publicly readable.
#
# Leave both blank to run local-only: the app works fully, but sessions stay
# in one browser and cannot be joined from another device.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
